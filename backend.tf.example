# Renombrá este archivo a backend.tf y completá los valores para mover el
# state fuera de tu máquina. Elegí UNA de las dos opciones.

# ─────────────────────────────────────────────────────────────
# Opción A: AWS S3 + DynamoDB (state locking)
# Requiere crear antes, una sola vez:
#   - un bucket S3 (con versioning y encryption activados)
#   - una tabla DynamoDB con clave primaria "LockID" (String)
# ─────────────────────────────────────────────────────────────
# terraform {
#   backend "s3" {
#     bucket         = "brew-and-co-tfstate"
#     key            = "cloudflare/terraform.tfstate"
#     region         = "us-east-1"
#     dynamodb_table = "brew-and-co-tf-locks"
#     encrypt        = true
#   }
# }

# ─────────────────────────────────────────────────────────────
# Opción B: Terraform Cloud (locking y storage incluidos, gratis para equipos chicos)
# ─────────────────────────────────────────────────────────────
# terraform {
#   cloud {
#     organization = "brew-and-co"
#     workspaces {
#       name = "cloudflare-pages"
#     }
#   }
# }

# Después de crear backend.tf, corré:
#   terraform init -migrate-state
